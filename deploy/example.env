# surf-indexer instance config: copy to /etc/surf-indexer/<genesisID>.env for the
# surf-indexer@<genesisID> unit, then check it:
#
#   sudo install -m 600 /usr/share/surf-indexer/example.env /etc/surf-indexer/mainnet-v1.0.env
#   sudoedit /etc/surf-indexer/mainnet-v1.0.env
#   sudo surf-indexer check -env-file /etc/surf-indexer/mainnet-v1.0.env mainnet-v1.0
#
# It holds tokens: keep it mode 600 (systemd reads it as root). Unset variables take the
# default shown in the commented line. Unknown names fail `check`; see the README's
# Environment Variables for details.

# Archival algod; ';'-separate several hosts for failover, with one port/token each or one shared.
ALGOD_HOST=http://localhost
ALGOD_PORT=8080
ALGOD_TOKEN=

# HTTP server. Bind to loopback (or a private address) behind a proxy; empty binds every interface.
LISTEN_ADDR=127.0.0.1
PORT=8118
# Behind a proxy: the header holding the visitor IP, trusted only from a loopback or private peer.
#REAL_IP_HEADER=CF-Connecting-IP

# DuckDB memory cap and worker threads. Unset, DuckDB takes 80% of RAM and every core:
# set them on a host shared with algod.
DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_THREADS=4

# What gets indexed. Fixed once the DB holds a block: changing them needs a rebuild.
#PROPOSERS=true
#VOTER_ROUNDS=100000
#LSIGS=false
#MSIGS=false

# Admin routes (need LSIGS): 16+ printable ASCII characters, e.g. `openssl rand -hex 32`.
#ADMIN_TOKEN=

# Request limits: per-client requests/s (0: none), and heavy requests at once (0: no cap).
#RATE_LIMIT=10
#HEAVY_CONCURRENCY=4

# Ingest: concurrent block fetches, and blocks per batch.
#CONCURRENCY=10
#DB_CHUNKS=1000

# Serve another DB of this network: /var/lib/surf-indexer/data/<DB_ID>.duckdb.
#DB_ID=

# Bulk load and trials, not for a service: see the README.
#LEDGER_DB=
#START_ROUND=0
