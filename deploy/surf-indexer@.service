# One instance per network, named by its genesis ID:
#   systemctl enable --now surf-indexer@mainnet-v1.0
# reads /etc/surf-indexer/mainnet-v1.0.env (ALGOD_*, PORT, ...) and keeps its
# DB in /var/lib/surf-indexer/data/mainnet-v1.0.duckdb.
[Unit]
Description=surf-indexer %i
After=network-online.target
Wants=network-online.target

[Service]
User=surf-indexer
Group=surf-indexer
EnvironmentFile=/etc/surf-indexer/%i.env
ExecStart=/usr/bin/surf-indexer %i
StateDirectory=surf-indexer
WorkingDirectory=/var/lib/surf-indexer
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
